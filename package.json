{
  "name": "nextjs-strict-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "bunx --bun prisma generate && next build",
    "start": "next start",
    "preview": "next start",
    "analyze": "next experimental-analyze",
    "check": "bun run format && bun run lint:ci && bun run typecheck && bun run test:coverage && bun run knip && bun run db:validate",
    "verify": "bun run check && bun run build",
    "lint": "oxlint && eslint --concurrency=auto --max-warnings=0",
    "lint:fix": "oxlint --fix && eslint --concurrency=auto --fix",
    "lint:ci": "oxlint --deny-warnings && eslint --concurrency=auto --max-warnings=0",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint --concurrency=auto --max-warnings=0",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "test:integration": "bun test ./tests/integration/*.integration.ts",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:production": "knip --production",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:check": "bunx --bun prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:migrate:status": "bunx --bun prisma migrate status",
    "db:seed": "bunx --bun prisma db seed",
    "db:studio": "bunx --bun prisma studio",
    "db:validate": "bunx --bun prisma validate",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@v2nic/eslint-plugin-prisma": "^2.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-rsc": "^5.18.3",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "knip": "^6.32.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.78.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1",
    "postcss": "^8.5.23",
    "zod-validation-error": "^4.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.0"
}
